ConnectionStrings__Kunlun=Host=127.0.0.1;Port=5432;Database=kunlun;Username=kunlun_app;Password=REPLACE_WITH_SECRET;Search Path=plugin_kunlun_waterstation,public
Kunlun__Jwt__Issuer=kunlun.waterstation
Kunlun__Jwt__Audience=kunlun.clients
Kunlun__Jwt__SigningKey=REPLACE_WITH_32_BYTE_SECRET
Kunlun__DefaultTenantId=00000000-0000-0000-0000-000000000001

# Explicit initial administrator; only used when staff table is empty.
Kunlun__Bootstrap__Username=admin
Kunlun__Bootstrap__Password=REPLACE_WITH_STRONG_PASSWORD
# Demo data is opt-in and requires Kunlun__SeedPassword. Never enable in production.
Kunlun__SeedDemoData=false

# Test payments are disabled by default. Mock requires Development/Testing AND
# an isolated database name containing 'test'; no real WeChat collection.
Kunlun__MiniPayments__Mode=Disabled
