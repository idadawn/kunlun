# Append to the existing /opt/atlas-wiki/Caddyfile after making a backup.
# Port 80 belongs to the existing HTTP gateway; ACME uses TLS-ALPN-01 on 443.
kunlun.idalee.cn {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    encode zstd gzip
    reverse_proxy kunlun-web:8080
}
