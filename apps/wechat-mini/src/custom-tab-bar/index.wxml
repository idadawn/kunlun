<view class="tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="page"
    class="tab {{selected === item.path ? 'on' : ''}}"
    data-page="{{item.page}}"
    bindtap="go"
    aria-role="tab"
    aria-selected="{{selected === item.path}}"
  >
    <image class="icon" src="/assets/tab/{{item.icon}}{{selected === item.path ? '-on' : ''}}.svg" />
    <text class="text">{{item.text}}</text>
  </view>
</view>
