.tabs {
  display: flex;
  background: #fffdf8;
  border-top: 1rpx solid #e3e8dd;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
}
.tab {
  position: relative;
  flex: 1;
  background: transparent;
  font-size: 26rpx;
  font-weight: 600;
  color: #738178;
  line-height: 72rpx;
  border: 0;
  margin: 0;
  padding: 0;
}
.tab::after {
  border: 0;
}
.active {
  color: #174e3c;
}
.dot {
  position: absolute;
  bottom: 0;
  left: calc(50% - 10rpx);
  width: 20rpx;
  height: 5rpx;
  background: #174e3c;
  border-radius: 6rpx;
}
