.tabbar {
  display: flex;
  background: #ffffff;
  box-shadow: 0 -1rpx 0 #eceef1;
  /* Stays within the native tab bar height (48px) that the runtime reserves for a custom tab bar. */
  padding: 8rpx 0 calc(4rpx + env(safe-area-inset-bottom));
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8f959e;
}
.icon {
  width: 48rpx;
  height: 48rpx;
}
.text {
  font-size: 20rpx;
  line-height: 32rpx;
  margin-top: 2rpx;
}
.on {
  color: #0d9488;
  font-weight: 600;
}
