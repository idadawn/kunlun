page {
  /* Theme: fresh teal on cool neutral grays. Change colors here. */
  --bg: #f5f7f8;
  --card: #ffffff;
  --ink: #1f2329;
  --ink-2: #646a73;
  --ink-3: #8f959e;
  --line: #eef0f2;
  /* --brand fills buttons and icons; text uses the darker --brand-text so small type stays legible. */
  --brand: #0d9488;
  --brand-text: #0f766e;
  --brand-soft: #e6f6f4;
  --price: #ec5a2b;
  --warn: #b5650f;
  --warn-soft: #fff4e4;
  --danger: #cf4436;
  --danger-soft: #fdeeec;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
.page {
  padding: 24rpx 24rpx 48rpx;
}
/* Room for the fixed cart bar or bottom action bar. */
.page.with-bar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.num {
  font-family: "DIN Alternate", "Helvetica Neue", -apple-system, sans-serif;
  font-variant-numeric: tabular-nums;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.muted {
  color: var(--ink-2);
  font-size: 26rpx;
}
.faint {
  color: var(--ink-3);
  font-size: 24rpx;
}
.strong {
  font-weight: 600;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 36rpx 8rpx 16rpx;
}

/* Cards and list rows */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card.flush {
  padding: 0 28rpx;
}
.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child {
  border-bottom: 0;
}
.cell-label {
  flex-shrink: 0;
  width: 150rpx;
  color: var(--ink-2);
}
.cell-value {
  flex: 1;
  min-width: 0;
  text-align: right;
}
.chev {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--ink-3);
  border-right: 3rpx solid var(--ink-3);
  transform: rotate(45deg);
  margin-right: 6rpx;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* Tags and status text */
.tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 22rpx;
  line-height: 36rpx;
  white-space: nowrap;
}
.tag.line {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx #bfe6e0;
}
.tag.warn {
  background: var(--warn-soft);
  color: var(--warn);
}
.tag.gray {
  background: #f0f2f5;
  color: var(--ink-2);
}
.status {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-text);
}
.status.PENDING {
  color: var(--warn);
}
.status.COMPLETED,
.status.CANCELLED {
  color: var(--ink-3);
}

/* Buttons are views so the native button chrome never fights the layout. */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--brand);
  color: #fff;
  box-sizing: border-box;
}
.btn.ghost {
  background: var(--brand-soft);
  color: var(--brand-text);
}
.btn.line {
  background: transparent;
  color: var(--ink);
  box-shadow: inset 0 0 0 1rpx #dcdfe4;
}
.btn.danger {
  background: transparent;
  color: var(--danger);
  box-shadow: inset 0 0 0 1rpx #efc9c4;
}
.btn.sm {
  height: 60rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
  font-weight: 500;
}
.btn.off {
  background: #c9cdd4;
  color: #fff;
  box-shadow: none;
}
.btn + .btn {
  margin-left: 16rpx;
}
.press {
  opacity: 0.75;
}
.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

/* Segmented switch */
.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #eef1f3;
}
.seg-item {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}
.seg-item.on {
  background: #fff;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.1);
}

/* Underline tabs for lists */
.tabs {
  display: flex;
  background: var(--card);
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tabs-item {
  flex: 1;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  position: relative;
}
.tabs-item.on {
  color: var(--ink);
  font-weight: 600;
}
.tabs-item.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  border-radius: 6rpx;
  background: var(--brand);
}

/* Takeout-style quantity control */
.stepper {
  display: flex;
  align-items: center;
}
.step {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 40rpx;
  font-weight: 500;
  box-sizing: border-box;
}
.step.minus {
  color: var(--brand);
  border: 2rpx solid #a8ddd5;
  background: #fff;
}
.step.plus {
  color: #fff;
  background: var(--brand);
}
.step.plus.off {
  background: #c9cdd4;
}
.step-qty {
  min-width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* Prices */
.price {
  color: var(--price);
  font-weight: 700;
  font-size: 40rpx;
  line-height: 1;
}
.price .yen {
  font-size: 24rpx;
  margin-right: 2rpx;
}
.price .per {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
  margin-left: 4rpx;
}

/* Product thumbnails */
.thumb {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: linear-gradient(160deg, #effaf8, #dcf1ed);
  display: flex;
  align-items: center;
  justify-content: center;
}
.thumb image {
  width: 132rpx;
  height: 132rpx;
}
.thumb.sm {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
}
.thumb.sm image {
  width: 80rpx;
  height: 80rpx;
}

/* Fixed bottom action bar for checkout-like pages */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: 0 -2rpx 16rpx rgba(31, 35, 41, 0.06);
}
.bottom-bar .btn {
  min-width: 260rpx;
}
.bottom-bar .btn + .btn {
  margin-left: 0;
}

/* Forms */
input,
textarea {
  font-size: 28rpx;
  color: var(--ink);
}
.input-placeholder {
  color: var(--ink-3);
}
.field {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #f2f4f6;
  box-sizing: border-box;
  width: 100%;
}
.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--card);
}
.search image {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.search input {
  flex: 1;
  height: 76rpx;
}

/* Avatars */
.avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Feedback */
.alert {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
.empty {
  padding: 80rpx 0 60rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}
.empty image {
  width: 200rpx;
  height: 200rpx;
  display: block;
  margin: 0 auto 16rpx;
}
.more {
  text-align: center;
  color: var(--ink-2);
  font-size: 26rpx;
  padding: 24rpx 0;
}
.footnote {
  text-align: center;
  color: var(--ink-3);
  font-size: 22rpx;
  margin-top: 40rpx;
}
