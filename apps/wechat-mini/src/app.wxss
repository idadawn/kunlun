page {
  background: #f7f8f2;
  color: #203b2f;
  font-family: "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
.page {
  padding: 28rpx 32rpx 52rpx;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #6f8376;
  font-weight: 600;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -1rpx;
  margin: 12rpx 0;
}
.subtitle,
.muted {
  color: #728276;
  font-size: 25rpx;
}
.section {
  margin-top: 40rpx;
}
.section-head,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 650;
}
.card {
  padding: 28rpx;
  border: 1rpx solid #e1e7dc;
  background: #fffefa;
  border-radius: 24rpx;
  margin-top: 20rpx;
}
.hero {
  position: relative;
  overflow: hidden;
  background: #174e3c;
  color: #fffefa;
  padding: 36rpx;
  border-radius: 28rpx;
  margin-top: 28rpx;
  min-height: 280rpx;
}
.hero .eyebrow,
.hero .muted {
  color: #b9d3bd;
}
.hero-title {
  font-size: 50rpx;
  font-weight: 650;
  line-height: 1.3;
  margin: 20rpx 0;
  max-width: 380rpx;
}
.hero-tag {
  display: inline-block;
  background: #d5ebbe;
  color: #174e3c;
  border-radius: 32rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}
.hero-art {
  position: absolute;
  right: 24rpx;
  bottom: -12rpx;
  width: 180rpx;
  height: 250rpx;
  border: 2rpx solid #7aa58d;
  border-radius: 48rpx 48rpx 30rpx 30rpx;
  transform: rotate(10deg);
  background: #2d6750;
}
.hero-art::before {
  content: "";
  position: absolute;
  left: 52rpx;
  top: -28rpx;
  width: 72rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #d5ebbe;
}
.hero-art::after {
  content: "绿麒麟\A 15L";
  white-space: pre;
  text-align: center;
  position: absolute;
  top: 80rpx;
  left: 0;
  right: 0;
  background: #f2f5e8;
  color: #174e3c;
  font-size: 25rpx;
  line-height: 1.7;
  padding: 12rpx 0;
}
.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 440rpx;
}
.quick {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.quick-item {
  flex: 1;
  text-align: left;
  padding: 26rpx;
  background: #eaf3ea;
  border-radius: 22rpx;
  margin: 0;
  font-size: 30rpx;
  color: #174e3c;
  line-height: 1.6;
}
.quick-item::after {
  border: 0;
}
.quick-item.secondary {
  background: #eeecdf;
}
.quick-small {
  font-size: 22rpx;
  color: #6a7c6d;
  display: block;
  margin-top: 10rpx;
}
.metric {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.metric small {
  font-size: 24rpx;
}
.metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 16rpx;
}
.metric-label {
  font-size: 22rpx;
  color: #738178;
  margin-top: 8rpx;
}
.badge {
  display: inline-block;
  background: #eaf3ea;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  color: #356a4e;
  font-size: 22rpx;
}
.badge.amber {
  background: #fff0d7;
  color: #8b672b;
}
.test-strip {
  font-size: 21rpx;
  color: #7a704e;
  background: #f0ecd9;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 24rpx;
}
.error {
  background: #fceee9;
  color: #9b4134;
  padding: 20rpx;
  border-radius: 16rpx;
  margin: 18rpx 0;
  font-size: 26rpx;
}
.primary,
.secondary-btn,
.danger {
  border-radius: 16rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 28rpx;
  margin-top: 24rpx;
}
.primary {
  background: #174e3c;
  color: #fffefa;
}
.primary::after,
.secondary-btn::after,
.danger::after {
  border: 0;
}
.primary[disabled] {
  background: #b7c6ba;
  color: #fff;
}
.secondary-btn {
  background: #eaf3ea;
  color: #174e3c;
}
.danger {
  background: #f8ece6;
  color: #994538;
}
.small-btn {
  font-size: 24rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
}
.text-link {
  background: transparent;
  font-size: 25rpx;
  color: #426950;
  padding: 0;
  margin: 0;
  line-height: 60rpx;
}
.text-link::after {
  border: 0;
}
.form-label {
  display: block;
  font-size: 24rpx;
  color: #687a6b;
  margin: 24rpx 0 12rpx;
}
input,
textarea,
.select {
  box-sizing: border-box;
  background: #f0f3eb;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  width: 100%;
  font-size: 28rpx;
  color: #203b2f;
}
input {
  height: 88rpx;
}
textarea {
  height: 140rpx;
}
.tabs-row {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0;
  flex-wrap: wrap;
}
.chip {
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  background: #edf0e6;
  color: #65755f;
  border-radius: 36rpx;
}
.chip::after {
  border: 0;
}
.chip.selected {
  background: #174e3c;
  color: #fff;
}
.divider {
  height: 1rpx;
  background: #e6eadd;
  margin: 22rpx 0;
}
.product {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.product-art {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 152rpx;
  background: #e5edde;
  border-radius: 22rpx;
  color: #35664b;
  font-size: 34rpx;
  font-weight: 700;
}
.product-art.bag {
  background: #e6eee8;
}
.product-name {
  font-size: 30rpx;
  font-weight: 600;
}
.detail {
  font-size: 24rpx;
  color: #7e897b;
  margin: 8rpx 0;
}
.price {
  font-size: 38rpx;
  font-weight: 650;
}
.unit {
  font-size: 24rpx;
  font-weight: 400;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.stepper button {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  line-height: 60rpx;
  margin: 0;
  background: #edf2e5;
  color: #174e3c;
}
.stepper button::after {
  border: 0;
}
.stepper text {
  min-width: 40rpx;
  text-align: center;
  font-size: 32rpx;
}
.empty {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #7c8879;
}
.list-title {
  font-size: 28rpx;
  font-weight: 600;
}
.order-no {
  font-size: 21rpx;
  color: #7c8879;
  letter-spacing: 1rpx;
}
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}
.pickup-code {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.account-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #dcebd5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #174e3c;
}
.numbered {
  font-family: "DIN Alternate", "PingFang SC", sans-serif;
}
.menu-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e6eadd;
}
.login {
  padding-top: 60rpx;
}
.login-mark {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}
.login-intro {
  font-size: 62rpx;
  line-height: 1.35;
  font-weight: 650;
  margin: 60rpx 0 24rpx;
}
.footer-note {
  font-size: 22rpx;
  color: #86907f;
  margin-top: 32rpx;
  line-height: 1.8;
}
.right {
  text-align: right;
}
.grow {
  flex: 1;
}
.inline-note {
  font-size: 22rpx;
  color: #6d7c66;
}
.loading {
  padding: 32rpx;
  color: #738178;
  text-align: center;
}
/* style v2 gives native buttons a fixed width; these controls follow our layout. */
.primary,
.secondary-btn,
.danger {
  width: 100%;
  box-sizing: border-box;
}
.small-btn,
.text-link,
.chip,
.quick-item {
  width: auto;
  min-width: 0;
}
.chip {
  flex-shrink: 0;
}
.quick-item {
  box-sizing: border-box;
}
.metric small {
  font-size: 24rpx;
}
.page button.primary,
.page button.secondary-btn,
.page button.danger {
  width: 100%;
}
.page button.small-btn,
.page button.text-link,
.page button.chip,
.page button.quick-item {
  width: auto;
}
.page button.primary {
  white-space: nowrap;
}
