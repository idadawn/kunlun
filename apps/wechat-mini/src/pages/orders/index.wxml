<view class="page"
  ><view class="eyebrow">{{staff ? 'ORDER DESK' : 'MY ORDERS'}}</view
  ><view class="title"
    >{{staff ? '每一单，都有回应' : '每一次用水，都有记录'}}</view
  ><view class="tabs-row"
    ><button
      wx:for="{{filters}}"
      wx:key="value"
      class="chip {{status === item.value ? 'selected' : ''}}"
      data-value="{{item.value}}"
      bindtap="filter"
    >
      {{item.text}}
    </button></view
  >
  <view wx:if="{{staff}}" class="row"
    ><input
      placeholder="输入自提码查找水单"
      value="{{pickupCode}}"
      bindinput="code"
      bindconfirm="search"
    /><button class="primary small-btn" bindtap="search">查询</button></view
  >
  <view wx:if="{{error}}" class="error"
    >{{error}}<button class="text-link" bindtap="search">重新加载</button></view
  >
  <view wx:for="{{orders}}" wx:key="id" class="card"
    ><view class="row"
      ><text class="order-no">{{item.orderNo}}</text
      ><text class="badge {{item.status === 'PENDING' ? 'amber' : ''}}"
        >{{item.statusText}}</text
      ></view
    ><view class="divider" /><view class="row"
      ><view
        ><view class="product-name">{{item.label}}</view
        ><view class="detail">{{item.modeText}} · {{item.timeText}}</view></view
      ><view class="price"
        >{{item.orderQty}}<text class="unit"> 份</text></view
      ></view
    ><view class="detail"
      >{{item.addressSnapshot.contactName}} ·
      {{item.addressSnapshot.address}}</view
    ><view wx:if="{{item.remark}}" class="detail">备注：{{item.remark}}</view>
    <view wx:if="{{!staff && item.pickupCode && item.status === 'PENDING'}}"
      ><view class="detail">到店出示自提码</view
      ><view class="pickup-code">{{item.pickupCode}}</view></view
    >
    <view class="order-foot"
      ><button
        wx:if="{{!staff && item.status === 'PENDING'}}"
        class="secondary-btn small-btn"
        data-id="{{item.id}}"
        bindtap="cancel"
        disabled="{{busy}}"
      >
        取消订水</button
      ><button
        wx:if="{{staff && canAccept && item.status === 'PENDING' && item.fulfillMode === 'DELIVERY'}}"
        class="primary small-btn"
        data-id="{{item.id}}"
        bindtap="accept"
        disabled="{{busy}}"
      >
        开始配送</button
      ><button
        wx:if="{{staff && canFulfill && (item.status === 'PENDING' || item.status === 'DISPATCHED')}}"
        class="secondary-btn small-btn"
        data-id="{{item.id}}"
        bindtap="fulfill"
      >
        {{item.fulfillMode === 'PICKUP' ? '自提核销' : '确认送达'}}
      </button></view
    >
  </view>
  <view wx:if="{{!orders.length && !busy}}" class="empty"
    >暂时没有符合条件的水单</view
  ><button
    wx:if="{{orders.length < total}}"
    class="secondary-btn"
    bindtap="more"
    loading="{{busy}}"
  >
    加载更多</button
  ><view wx:if="{{busy}}" class="loading">正在加载…</view>
</view>
