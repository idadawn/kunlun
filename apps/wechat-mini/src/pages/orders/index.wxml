<view class="tabs">
  <view wx:for="{{filters}}" wx:key="value" class="tabs-item {{status === item.value ? 'on' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.text}}</view>
</view>
<view class="page">
  <view wx:if="{{staff}}" class="search">
    <image src="/assets/icons/search.svg" />
    <input type="number" value="{{pickupCode}}" placeholder="输入取水码查找" placeholder-class="input-placeholder" confirm-type="search" bindinput="code" bindconfirm="search" />
    <text wx:if="{{pickupCode}}" class="faint" bindtap="clearCode">清除</text>
  </view>
  <view wx:if="{{error}}" class="alert" bindtap="search">{{error}}</view>

  <view wx:for="{{orders}}" wx:key="id" class="card order">
    <view class="row between">
      <text class="faint">{{item.modeText}} · {{item.shortTime}}</text>
      <text class="status {{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="row order-body">
      <view class="thumb sm"><image src="{{item.image}}" mode="aspectFit" /></view>
      <view class="grow">
        <view class="strong">{{item.label}}</view>
        <view wx:if="{{item.active && item.appointmentSlot}}" class="faint">{{item.appointmentSlot}}</view>
      </view>
      <text class="qty num">× {{item.orderQty}}</text>
    </view>
    <view wx:if="{{staff}}" class="order-who">
      <text class="strong">{{item.addressSnapshot.contactName}}</text>
      <view class="phone" hover-class="press" data-phone="{{item.addressSnapshot.contactPhone}}" bindtap="call">
        <image src="/assets/icons/phone.svg" />{{item.addressSnapshot.contactPhone}}
      </view>
    </view>
    <view wx:if="{{item.fulfillMode === 'DELIVERY'}}" class="muted">{{item.addressSnapshot.address}}</view>
    <view wx:if="{{item.remark}}" class="muted">备注：{{item.remark}}</view>
    <view wx:if="{{item.showCode}}" class="pickup">
      <text class="muted">取水码</text>
      <text class="pickup-code num">{{item.pickupCode}}</text>
    </view>
    <view wx:if="{{item.hasActions}}" class="actions">
      <view wx:if="{{item.canCancel}}" class="btn sm line" hover-class="press" data-id="{{item.id}}" bindtap="cancel">取消订单</view>
      <view wx:if="{{item.canReorder}}" class="btn sm ghost" hover-class="press" data-id="{{item.id}}" bindtap="reorder">再来一单</view>
      <view wx:if="{{item.canAccept}}" class="btn sm line" hover-class="press" data-id="{{item.id}}" bindtap="accept">开始配送</view>
      <view wx:if="{{item.canFulfill}}" class="btn sm" hover-class="press" data-id="{{item.id}}" bindtap="fulfill">{{item.fulfillMode === 'PICKUP' ? '核销取水' : '确认送达'}}</view>
    </view>
  </view>

  <view wx:if="{{!orders.length && !busy}}" class="empty">
    <image src="/assets/icons/empty.svg" />
    <view>{{staff ? '暂时没有水单' : '还没有订单'}}</view>
    <view wx:if="{{!staff}}" class="btn sm ghost empty-go" hover-class="press" bindtap="shop">去点水</view>
  </view>
  <view wx:if="{{orders.length < total}}" class="more" bindtap="more">{{busy ? '加载中…' : '加载更多'}}</view>
</view>
