<view class="page">
  <view class="search members-search">
    <image src="/assets/icons/search.svg" />
    <input value="{{query}}" placeholder="姓名、手机号或会员号" placeholder-class="input-placeholder" confirm-type="search" bindinput="input" bindconfirm="search" />
  </view>
  <view wx:if="{{error}}" class="alert" bindtap="search">{{error}}</view>
  <view wx:for="{{members}}" wx:key="id" class="card">
    <view class="row">
      <view class="avatar">{{item.initial}}</view>
      <view class="grow">
        <view class="strong">{{item.name}}</view>
        <view class="faint">{{item.phone}} · {{item.memberNo}}</view>
      </view>
      <view wx:if="{{canOrder}}" class="btn sm" hover-class="press" data-id="{{item.id}}" bindtap="order">代客下单</view>
    </view>
    <view class="tickets">
      <view class="ticket"><view class="num strong">{{item.bucketDeliveryTickets}}</view><view class="faint">桶 · 配送</view></view>
      <view class="ticket"><view class="num strong">{{item.bucketPickupTickets}}</view><view class="faint">桶 · 自提</view></view>
      <view class="ticket"><view class="num strong">{{item.bagDeliveryTickets}}</view><view class="faint">袋 · 配送</view></view>
      <view class="ticket"><view class="num strong">{{item.bagPickupTickets}}</view><view class="faint">袋 · 自提</view></view>
    </view>
  </view>
  <view wx:if="{{!members.length && !busy}}" class="empty">
    <image src="/assets/icons/empty.svg" />没有找到会员
  </view>
  <view wx:if="{{members.length < total}}" class="more" bindtap="more">{{busy ? '加载中…' : '加载更多'}}</view>
</view>
