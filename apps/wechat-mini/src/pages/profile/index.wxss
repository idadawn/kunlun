.me {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 8rpx 36rpx;
}
.me-avatar {
  width: 112rpx;
  height: 112rpx;
  font-size: 44rpx;
  background: var(--brand);
  color: #fff;
}
.me-name {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}
.assets {
  display: flex;
  padding: 32rpx 0;
}
.asset {
  flex: 1;
  text-align: center;
}
.asset + .asset {
  border-left: 1rpx solid var(--line);
}
.asset-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}
.logout {
  margin-top: 40rpx;
  background: #fff;
}
