<view class="page">
  <view class="me">
    <view class="avatar me-avatar">{{initial}}</view>
    <view class="grow">
      <view class="me-name">{{user.displayName}}</view>
      <view class="faint">{{subline}}</view>
    </view>
    <text class="tag">{{staff ? '员工' : '会员'}}</text>
  </view>

  <view wx:if="{{!staff}}" class="card assets">
    <view class="asset" hover-class="press" bindtap="wallet"><view class="asset-num num">{{tickets}}</view><view class="faint">水票</view></view>
    <view class="asset"><view class="asset-num num">{{profile.heldBuckets || 0}}</view><view class="faint">在用水桶</view></view>
    <view class="asset"><view class="asset-num num">{{profile.heldBags || 0}}</view><view class="faint">在用水袋</view></view>
    <view class="asset"><view class="asset-num num">¥{{deposit}}</view><view class="faint">押金</view></view>
  </view>

  <view class="card flush">
    <block wx:if="{{!staff}}">
      <view class="cell" hover-class="press" bindtap="orders"><text class="grow">我的订单</text><view class="chev" /></view>
      <view class="cell" hover-class="press" bindtap="addresses"><text class="grow">收货地址</text><view class="chev" /></view>
      <view class="cell" hover-class="press" bindtap="wallet"><text class="grow">水票与购买记录</text><view class="chev" /></view>
    </block>
    <block wx:else>
      <view class="cell" hover-class="press" bindtap="orders"><text class="grow">水单</text><view class="chev" /></view>
      <view wx:if="{{canMembers}}" class="cell" hover-class="press" bindtap="members"><text class="grow">会员查询</text><view class="chev" /></view>
    </block>
  </view>
  <view wx:if="{{error}}" class="alert" bindtap="load">{{error}}</view>
  <view class="btn line logout" hover-class="press" bindtap="logout">退出登录</view>
  <view class="footnote">{{brand.store}} · {{demo ? '本地演示' : '测试版'}}</view>
</view>
