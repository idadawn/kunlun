<view class="page"
  ><view class="eyebrow">MY KUNLUN</view
  ><view class="title">很高兴，与你相伴</view
  ><view class="card"
    ><view class="row"
      ><view class="account-mark">{{staff ? '工' : '会'}}</view
      ><view class="grow"
        ><view class="product-name">{{user.displayName}}</view
        ><view class="detail">{{user.codeOrNo}}</view></view
      ><view class="badge">{{staff ? '员工' : '会员'}}</view></view
    ></view
  >
  <view wx:if="{{!staff}}" class="card"
    ><view class="row"
      ><view
        ><view class="metric"
          >{{profile.heldBuckets || 0}}<text class="unit"> 个</text></view
        ><view class="metric-label">持有水桶</view></view
      ><view
        ><view class="metric"
          >{{profile.heldBags || 0}}<text class="unit"> 个</text></view
        ><view class="metric-label">持有水袋</view></view
      ><view
        ><view class="metric"
          >{{profile.depositAmount || 0}}<text class="unit"> 元</text></view
        ><view class="metric-label">押金余额</view></view
      ></view
    ></view
  >
  <view class="card"
    ><view wx:if="{{!staff}}" class="menu-row row" bindtap="addresses"
      ><text>收货地址</text><text>→</text></view
    ><view class="menu-row row" bindtap="wallet"
      ><text>{{staff ? '门店业务' : '水票与购买记录'}}</text
      ><text>→</text></view
    ><view class="menu-row row"
      ><text>当前环境</text
      ><text class="badge">{{demo ? '本地测试' : '接口测试'}}</text></view
    ></view
  >
  <view wx:if="{{error}}" class="error">{{error}}</view
  ><button class="secondary-btn" bindtap="logout" disabled="{{busy}}">
    退出登录</button
  ><view class="footer-note"
    >绿麒麟水站 · 鲜活每一滴，好水到你家。<view
      >测试版：模拟支付不扣款，身份权限由服务端核验。</view
    ></view
  >
</view>
