.for-member {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 26rpx;
  font-weight: 600;
}
.where {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0 8rpx;
}
.where image {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}
.where-main {
  font-size: 30rpx;
  font-weight: 600;
}
.where-main.add {
  color: var(--brand-text);
}
.slot {
  border-top: 1rpx solid var(--line);
  margin-top: 20rpx;
  min-height: 96rpx;
}
.line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}
.line-pay {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.sum-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.sum-row.total {
  padding-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.remark {
  height: 104rpx;
}

.done {
  text-align: center;
  padding-top: 72rpx;
}
.done-icon {
  width: 128rpx;
  height: 128rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 24rpx 0 8rpx;
}
.done-list {
  text-align: left;
  margin-top: 48rpx;
}
.code {
  text-align: right;
}
.code-num {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--brand-text);
  line-height: 1.1;
}
.done-actions {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}
.done-actions .btn {
  width: 260rpx;
}
