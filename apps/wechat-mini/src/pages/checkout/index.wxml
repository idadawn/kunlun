<view wx:if="{{done}}" class="page done">
  <image class="done-icon" src="/assets/icons/check.svg" />
  <view class="done-title">下单成功</view>
  <view class="muted">{{done.pickup ? '到店出示取水码即可领取' : (done.slot === '尽快送达' ? '我们会尽快送到' : '预约送达 ' + done.slot)}}</view>
  <view class="card done-list">
    <view wx:for="{{done.orders}}" wx:key="id" class="line">
      <view class="thumb sm"><image src="{{item.image}}" mode="aspectFit" /></view>
      <view class="grow">
        <view class="strong">{{item.label}} × {{item.orderQty}}</view>
        <view class="faint">{{item.payText}}</view>
      </view>
      <view wx:if="{{item.pickupCode}}" class="code">
        <view class="faint">取水码</view>
        <view class="code-num num">{{item.pickupCode}}</view>
      </view>
    </view>
  </view>
  <view class="done-actions">
    <view class="btn line" hover-class="press" bindtap="again">{{staff ? '继续下单' : '继续点水'}}</view>
    <view class="btn" hover-class="press" bindtap="viewOrders">查看订单</view>
  </view>
</view>

<block wx:else>
  <view class="page with-bar">
    <view wx:if="{{staff && memberName}}" class="for-member">为 {{memberName}} 下单</view>
    <view class="card">
      <view class="seg">
        <view class="seg-item {{mode === 'DELIVERY' ? 'on' : ''}}" data-mode="DELIVERY" bindtap="setMode">送水上门</view>
        <view class="seg-item {{mode === 'PICKUP' ? 'on' : ''}}" data-mode="PICKUP" bindtap="setMode">到店自提</view>
      </view>
      <block wx:if="{{mode === 'DELIVERY'}}">
        <view class="where" hover-class="press" bindtap="chooseAddress">
          <image src="/assets/icons/location.svg" />
          <view wx:if="{{address}}" class="grow">
            <view class="where-main">{{address.fullAddress}}</view>
            <view class="faint">{{address.contactName}} {{address.phoneText}}</view>
          </view>
          <view wx:else class="grow where-main add">添加收货地址</view>
          <view class="chev" />
        </view>
        <picker range="{{slots}}" value="{{slot}}" bindchange="pickSlot">
          <view class="cell slot">
            <text class="cell-label">送达时间</text>
            <text class="cell-value strong">{{slots[slot]}}</text>
            <view class="chev" />
          </view>
        </picker>
      </block>
      <view wx:else class="where">
        <image src="/assets/icons/store.svg" />
        <view class="grow">
          <view class="where-main">{{brand.store}}</view>
          <view class="faint">营业时间 {{brand.hours}} · 凭取水码领取</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view wx:for="{{sum.lines}}" wx:key="waterType" class="line">
        <view class="thumb sm"><image src="{{item.image}}" mode="aspectFit" /></view>
        <view class="grow">
          <view class="strong">{{item.name}}</view>
          <view class="faint">× {{item.qty}}</view>
        </view>
        <view class="line-pay">
          <view wx:if="{{item.useTickets}}" class="tag">水票 {{item.useTickets}} {{item.unit}}</view>
          <view wx:if="{{item.amountFen}}" class="strong num">¥{{item.amountText}}</view>
        </view>
      </view>
      <view wx:if="{{!sum.lines.length && !busy}}" class="faint">还没有选水品</view>
      <view class="divider" />
      <view wx:if="{{mode === 'DELIVERY' && freeDelivery}}" class="sum-row"><text class="muted">配送费</text><text>免费</text></view>
      <view wx:if="{{sum.ticketText}}" class="sum-row"><text class="muted">水票抵扣</text><text>{{sum.ticketText}}</text></view>
      <view wx:if="{{deposit.fen}}" class="sum-row"><text class="muted">押金（{{mode === 'DELIVERY' ? '送达时付' : '取水时付'}}）</text><text>¥{{deposit.amountText}}</text></view>
      <view class="sum-row total"><text>{{sum.amountFen ? '需支付' : '无需另付'}}</text><text class="price num"><text class="yen">¥</text>{{sum.amountText}}</text></view>
    </view>

    <view class="card flush">
      <view class="cell">
        <text class="cell-label">备注</text>
        <input class="grow remark" value="{{remark}}" maxlength="200" placeholder="{{mode === 'DELIVERY' ? '如：空桶放门口' : '选填'}}" placeholder-class="input-placeholder" bindinput="input" />
      </view>
    </view>
    <view wx:if="{{sum.blocker}}" class="alert">{{sum.blocker}}</view>
    <view wx:if="{{error}}" class="alert">{{error}}</view>
  </view>
  <view class="bottom-bar">
    <view class="grow">
      <view class="faint">{{sum.amountFen ? '需支付' : '水票支付'}}</view>
      <view class="price num"><text class="yen">¥</text>{{sum.amountText}}</view>
    </view>
    <view class="btn {{sum.ready && !busy ? '' : 'off'}}" hover-class="{{sum.ready && !busy ? 'press' : 'none'}}" bindtap="submit" aria-role="button">{{busy ? '提交中…' : (sum.amountFen ? '支付并下单' : '提交订单')}}</view>
  </view>
</block>
