/* A soft tint continues the navigation bar behind the first card and fades into the page. */
.hero {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(180deg, #dff4f1 0%, var(--bg) 100%);
}
.home {
  position: relative;
}
.store {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.06);
}
.logo {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
}
.store-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}
.store-seg {
  margin-top: 28rpx;
}
.where {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.where image {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}
.where-main {
  font-size: 30rpx;
  font-weight: 600;
}
.ongoing {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  font-size: 26rpx;
}
.promo {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 26rpx;
  color: var(--brand-text);
  font-weight: 600;
}

/* Staff workspace */
.stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}
.stat-num.warn {
  color: var(--warn);
}
.tiles {
  display: flex;
  gap: 20rpx;
}
.tile {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 28rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.tile image {
  width: 64rpx;
  height: 64rpx;
}
.recent {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
