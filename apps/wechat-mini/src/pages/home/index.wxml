<view class="hero" />
<view class="page home {{staff ? '' : 'with-bar'}}">
  <block wx:if="{{!staff}}">
    <view class="store">
      <view class="row">
        <image class="logo" src="/assets/logo.svg" />
        <view class="grow">
          <view class="store-name">{{brand.store}}</view>
          <view class="faint">{{brand.product}}</view>
        </view>
        <text wx:if="{{freeDelivery && mode === 'DELIVERY'}}" class="tag">免配送费</text>
      </view>
      <view class="seg store-seg">
        <view class="seg-item {{mode === 'DELIVERY' ? 'on' : ''}}" data-mode="DELIVERY" bindtap="setMode">送水上门</view>
        <view class="seg-item {{mode === 'PICKUP' ? 'on' : ''}}" data-mode="PICKUP" bindtap="setMode">到店自提</view>
      </view>
      <view wx:if="{{mode === 'DELIVERY'}}" class="where" hover-class="press" bindtap="chooseAddress">
        <image src="/assets/icons/location.svg" />
        <view class="grow">
          <view class="where-main ellipsis">{{address ? address.fullAddress : '添加收货地址'}}</view>
          <view wx:if="{{address}}" class="faint">{{address.contactName}} {{address.phoneText}}</view>
        </view>
        <view class="chev" />
      </view>
      <view wx:else class="where">
        <image src="/assets/icons/store.svg" />
        <view class="grow">
          <view class="where-main">{{brand.store}}</view>
          <view class="faint">营业时间 {{brand.hours}} · 凭取水码领取</view>
        </view>
      </view>
    </view>
    <view wx:if="{{ongoing}}" class="ongoing" hover-class="press" bindtap="openOrders">
      <text class="status {{ongoing.status}}">{{ongoing.statusText}}</text>
      <text class="grow ellipsis">{{ongoing.label}} × {{ongoing.orderQty}}{{ongoing.pickupCode && ongoing.status === 'PENDING' ? '　取水码 ' + ongoing.pickupCode : ''}}</text>
      <view class="chev" />
    </view>
    <view wx:if="{{error}}" class="alert" bindtap="load">{{error}}，点此重试</view>
    <water-menu items="{{items}}" bar="{{bar}}" tabbar bind:step="onStep" bind:checkout="onCheckout" bind:tickets="onTickets" />
    <view wx:if="{{items.length}}" class="promo" hover-class="press" bindtap="onTickets">
      <text class="grow">办水票，每次订水更省</text>
      <text class="faint">去看看</text>
      <view class="chev" />
    </view>
  </block>

  <block wx:else>
    <view class="store">
      <view class="row">
        <view class="avatar">{{initial}}</view>
        <view class="grow">
          <view class="store-name">{{user.displayName}}</view>
          <view class="faint">{{roleText}} · {{user.codeOrNo}}</view>
        </view>
      </view>
      <view class="stats">
        <view class="stat" hover-class="press" data-status="PENDING" bindtap="openOrders">
          <view class="stat-num num warn">{{stats.pending || 0}}</view>
          <view class="faint">待处理</view>
        </view>
        <view class="stat" hover-class="press" data-status="DISPATCHED" bindtap="openOrders">
          <view class="stat-num num">{{stats.dispatched || 0}}</view>
          <view class="faint">配送中</view>
        </view>
        <view class="stat" hover-class="press" data-status="" bindtap="openOrders">
          <view class="stat-num num">{{stats.total || 0}}</view>
          <view class="faint">全部水单</view>
        </view>
      </view>
    </view>
    <view wx:if="{{error}}" class="alert" bindtap="load">{{error}}，点此重试</view>
    <view class="tiles">
      <view class="tile" hover-class="press" data-status="PENDING" bindtap="openOrders">
        <image src="/assets/tab/order-on.svg" /><text>处理水单</text>
      </view>
      <view wx:if="{{canFulfill}}" class="tile" hover-class="press" bindtap="verify">
        <image src="/assets/tab/ticket-on.svg" /><text>核销取水码</text>
      </view>
      <view wx:if="{{canMembers}}" class="tile" hover-class="press" bindtap="openMembers">
        <image src="/assets/tab/team-on.svg" /><text>代客下单</text>
      </view>
    </view>
    <view class="section-title">最近水单</view>
    <view wx:for="{{recent}}" wx:key="id" class="card recent" hover-class="press" data-status="{{item.status}}" bindtap="openOrders">
      <view class="thumb sm"><image src="{{item.image}}" mode="aspectFit" /></view>
      <view class="grow">
        <view class="strong">{{item.label}} × {{item.orderQty}}</view>
        <view class="faint ellipsis">{{item.modeText}} · {{item.addressSnapshot.contactName}} · {{item.shortTime}}</view>
      </view>
      <text class="status {{item.status}}">{{item.statusText}}</text>
    </view>
    <view wx:if="{{!recent.length && !busy}}" class="empty">暂时没有水单</view>
  </block>
</view>
