<view class="page with-bar">
  <view class="card">
    <view class="row">
      <view class="avatar">{{initial}}</view>
      <view class="grow">
        <view class="strong">{{profile.name}}</view>
        <view class="faint">{{profile.phone}} · {{profile.memberNo}}</view>
      </view>
      <view class="btn sm line" hover-class="press" bindtap="back">换会员</view>
    </view>
    <view class="seg shop-seg">
      <view class="seg-item {{mode === 'DELIVERY' ? 'on' : ''}}" data-mode="DELIVERY" bindtap="setMode">送水上门</view>
      <view class="seg-item {{mode === 'PICKUP' ? 'on' : ''}}" data-mode="PICKUP" bindtap="setMode">到店自提</view>
    </view>
  </view>
  <view wx:if="{{error}}" class="alert" bindtap="load">{{error}}</view>
  <water-menu items="{{items}}" bar="{{bar}}" buy="{{false}}" bind:step="onStep" bind:checkout="onCheckout" bind:tickets="onTickets" />
</view>
