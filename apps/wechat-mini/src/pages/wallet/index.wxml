<view class="page">
  <view class="balance">
    <view class="balance-title">我的水票</view>
    <view class="balance-grid">
      <view wx:for="{{balances}}" wx:key="waterType" class="balance-item">
        <view class="balance-name">{{item.name}}</view>
        <view class="balance-row">
          <view><text class="balance-num num">{{item.delivery}}</text><text class="balance-unit">配送</text></view>
          <view><text class="balance-num num">{{item.pickup}}</text><text class="balance-unit">自提</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="seg wallet-seg">
    <view wx:for="{{products}}" wx:key="waterType" class="seg-item {{water === item.waterType ? 'on' : ''}}" data-water="{{item.waterType}}" bindtap="pick">{{item.name}}</view>
  </view>
  <view wx:if="{{error}}" class="alert">{{error}}</view>
  <view class="plans">
    <view wx:for="{{plans}}" wx:key="id" class="plan" hover-class="press" data-id="{{item.id}}" bindtap="buy" aria-role="button">
      <view class="row between">
        <text class="tag {{item.fulfillMode === 'PICKUP' ? 'gray' : ''}}">{{item.modeText}}</text>
        <text wx:if="{{item.giftQty}}" class="tag warn">赠 {{item.giftQty}}</text>
      </view>
      <view class="plan-qty"><text class="num">{{item.total}}</text><text class="plan-unit">{{item.unit}}</text></view>
      <view class="faint">约 ¥{{item.unitText}}/{{item.unit}}</view>
      <view class="plan-foot">
        <view class="price num"><text class="yen">¥</text>{{item.priceText}}</view>
        <view class="btn sm">购买</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!plans.length && !busy}}" class="empty">暂无可购买的水票</view>

  <block wx:if="{{payments.length}}">
    <view class="section-title">购买记录</view>
    <view class="card flush">
      <view wx:for="{{payments}}" wx:key="id" class="cell">
        <view class="grow">
          <view class="ellipsis">{{item.title}}</view>
          <view class="faint">{{item.timeText}}</view>
        </view>
        <view class="pay-right">
          <view class="strong num">¥{{item.amountText}}</view>
          <view wx:if="{{item.status === 'NOTPAY'}}" class="pay-link" hover-class="press" data-id="{{item.id}}" bindtap="retry">继续支付</view>
          <view wx:else class="faint">{{item.stateText}}</view>
        </view>
      </view>
    </view>
  </block>
  <view class="footnote">测试版 · 模拟支付不会扣款</view>
</view>
