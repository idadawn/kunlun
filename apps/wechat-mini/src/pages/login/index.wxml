<view class="login">
  <view class="brand">
    <image class="brand-logo" src="/assets/logo.svg" />
    <view class="brand-name">{{brand.store}}</view>
    <view class="muted">{{brand.product}}</view>
  </view>
  <view class="card login-card">
    <view class="seg">
      <view class="seg-item {{type === 'MEMBER' ? 'on' : ''}}" data-type="MEMBER" bindtap="choose">我是会员</view>
      <view class="seg-item {{type === 'STAFF' ? 'on' : ''}}" data-type="STAFF" bindtap="choose">我是员工</view>
    </view>
    <block wx:if="{{!demo}}">
      <input class="field" value="{{account}}" data-field="account" bindinput="input" placeholder="账号" placeholder-class="input-placeholder" maxlength="32" />
      <input class="field" password value="{{password}}" data-field="password" bindinput="input" bindconfirm="login" placeholder="密码" placeholder-class="input-placeholder" maxlength="128" />
    </block>
    <view wx:if="{{error}}" class="alert login-alert">{{error}}</view>
    <view class="btn login-btn {{busy ? 'off' : ''}}" hover-class="{{busy ? 'none' : 'press'}}" bindtap="login" aria-role="button">{{busy ? '请稍候…' : (demo ? '进入体验' : '登录')}}</view>
    <view class="faint login-note">{{demo ? '本地演示 · 数据只保存在本机' : (type === 'MEMBER' ? '账号由门店开通' : '账号由管理员分配')}}</view>
  </view>
</view>
