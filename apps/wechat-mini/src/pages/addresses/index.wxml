<block wx:if="{{!editing}}">
  <view class="page with-bar">
    <view wx:if="{{error}}" class="alert" bindtap="load">{{error}}</view>
    <view wx:for="{{addresses}}" wx:key="id" class="card addr {{select && item.id === selectedId ? 'picked' : ''}}" hover-class="press" data-id="{{item.id}}" bindtap="tap">
      <view class="grow">
        <view class="addr-main">{{item.fullAddress}}<text wx:if="{{item.isDefault}}" class="tag addr-tag">默认</text></view>
        <view class="faint">{{item.contactName}} {{item.phoneText}}</view>
      </view>
      <view class="addr-edit" hover-class="press" data-id="{{item.id}}" catchtap="edit">编辑</view>
    </view>
    <view wx:if="{{!addresses.length && !busy}}" class="empty">
      <image src="/assets/icons/empty.svg" />还没有收货地址
    </view>
  </view>
  <view class="bottom-bar">
    <view class="btn grow" hover-class="press" bindtap="edit">新增收货地址</view>
  </view>
</block>

<block wx:else>
  <view class="page with-bar">
    <view class="card flush">
      <view class="cell">
        <text class="cell-label">联系人</text>
        <input class="grow cell-input" maxlength="64" value="{{form.contactName}}" data-field="contactName" bindinput="input" placeholder="收货人姓名" placeholder-class="input-placeholder" />
      </view>
      <view class="cell">
        <text class="cell-label">手机号</text>
        <input class="grow cell-input" type="number" maxlength="11" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="input" placeholder="11 位手机号" placeholder-class="input-placeholder" />
      </view>
      <view class="cell">
        <text class="cell-label">小区/街道</text>
        <input class="grow cell-input" maxlength="180" value="{{form.location}}" data-field="location" bindinput="input" placeholder="如：绿麒麟花园 1 栋" placeholder-class="input-placeholder" />
      </view>
      <view class="cell">
        <text class="cell-label">门牌号</text>
        <input class="grow cell-input" maxlength="100" value="{{form.doorNo}}" data-field="doorNo" bindinput="input" placeholder="单元、楼层、房号" placeholder-class="input-placeholder" />
      </view>
      <view class="cell">
        <text class="grow">设为默认地址</text>
        <switch checked="{{form.isDefault}}" color="#0D9488" bindchange="isDefault" />
      </view>
    </view>
    <view wx:if="{{error}}" class="alert">{{error}}</view>
  </view>
  <view class="bottom-bar">
    <view class="btn line" hover-class="press" bindtap="close">取消</view>
    <view class="btn grow {{busy ? 'off' : ''}}" hover-class="press" bindtap="save">{{busy ? '保存中…' : '保存'}}</view>
  </view>
</block>
