    {
      "code": "COURIER",
      "name": "送水员",
      "permissions": [
        "kunlun.waterstation:member:read",
        "kunlun.waterstation:order:accept",
        "kunlun.waterstation:order:fulfill",
        "kunlun.waterstation:deposit:collect"
